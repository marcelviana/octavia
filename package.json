{
  "name": "octavia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' pnpm exec next dev",
    "build": "pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "pnpm exec next lint",
    "test": "pnpm exec vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "ux:harvest": "playwright test --config=playwright.ux-audit.config.ts",
    "test:ui": "vitest --ui",
    "test:unit": "pnpm run test",
    "db:types": "supabase gen types typescript --project-id mlxjmpbdchmwplcfislt > types/database.types.ts",
    "db:dump": "supabase db dump -s public -f supabase/schema.dump.sql",
    "db:dump:storage": "supabase db dump -s storage -f supabase/storage.dump.sql"
  },
  "dependencies": {
    "@octavia/identidade": "workspace:*",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.89.0",
    "@vitest/browser": "4.0.16",
    "@vitest/ui": "4.0.16",
    "clsx": "^2.1.1",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "happy-dom": "20.0.11",
    "mammoth": "^1.9.1",
    "next": "15.2.8",
    "pdfjs-dist": "4.8.69",
    "react": "^18",
    "react-dom": "^18",
    "react-pdf": "^9.2.1",
    "tailwind-merge": "^2.5.5",
    "vitest": "4.0.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "3.2.2",
    "dependency-cruiser": "^18.1.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "jsdom": "^26.1.0",
    "knip": "^6.29.0",
    "msw": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
