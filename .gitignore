# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
# allow service worker fallback script
# fallback-* is generated at build time, but we keep the versioned file in repo
!fallback-*.js

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# nativo (N0-PR1): pastas geradas pelo prebuild do Expo
apps/native/android/
apps/native/ios/
.expo/
# workspace (N0-PR2): node_modules dos pacotes — o /node_modules acima é ancorado na raiz
apps/*/node_modules/
packages/*/node_modules/

# typescript
*.tsbuildinfo
next-env.d.ts

# coverage
coverage/

# test results
test-results/
playwright-report/

# ux-audit auth state (contém tokens de sessão)
tests/ux-audit/.auth/

# backup files
*.backup
*.bak
*.old
*~

# macOS
.DS_Store
**/.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp

# Development and planning artifacts
.claude/
.planning/research/

# Traces do UX audit (Fase D): 147MB — arquivados fora do repo
# (~/octavia-ux-audit-fase-d-traces-*.zip); data/ e evidence/ são versionados
docs/ux/fase-d/traces/

# Artefatos gerados da auditoria (logs de comando e grafos do dependency-cruiser) — os .md de .audit/ ficam
.audit/logs/
.audit/*.json

# G-faixa (I1-PR5, div. 616/632): o perfil do navegador com a sessão (G_FAIXA_PERFIL).
# Mora FORA da árvore ($HOME/.octavia-g-faixa-perfil, scripts/gates-web/COMO-RODAR.md) e a
# config recusa um caminho dentro dela; a linha guarda o nome documentado, se ele cair aqui.
.octavia-g-faixa-perfil/
